{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "NodeNext", // ✅ critical for axios & modern deps
    "esModuleInterop": true, // ✅ allows `import axios from "axios"`
    "allowSyntheticDefaultImports": true, // ✅ smoother interop with CJS
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "jsx": "react-jsx"
  }
}
